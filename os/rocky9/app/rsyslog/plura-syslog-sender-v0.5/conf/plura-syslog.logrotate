/var/log/plura/sender.log /var/log/plura/rejected.log /var/log/plura/rsyslog-stats.jsonl {
    daily
    maxsize 100M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root root
    sharedscripts
    postrotate
        /bin/systemctl kill -s HUP --kill-whom=main rsyslog.service >/dev/null 2>&1 || true
    endscript
}
